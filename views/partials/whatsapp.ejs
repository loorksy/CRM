<!-- مودال QR -->
<div id="waQrModal" class="fixed inset-0 z-[10050] hidden items-center justify-center bg-slate-900/50 p-4" aria-hidden="true">
  <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-xl" role="dialog" aria-modal="true" aria-labelledby="waQrTitle" dir="rtl">
    <div class="mb-4 flex items-start justify-between gap-3">
      <div>
        <h3 id="waQrTitle" class="text-lg font-bold text-slate-900">رمز QR للربط</h3>
        <p id="waQrHint" class="mt-1 text-sm text-slate-500">امسح الرمز من واتساب ← الأجهزة المرتبطة</p>
      </div>
      <button type="button" id="waQrCloseBtn" class="inline-flex h-9 w-9 items-center justify-center rounded-xl text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" aria-label="إغلاق">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div id="waQrLoading" class="flex flex-col items-center justify-center gap-3 py-10">
      <i class="fas fa-spinner fa-spin text-2xl text-indigo-600" aria-hidden="true"></i>
      <p class="text-sm text-slate-600">جاري توليد الرمز… قد يستغرق بضع ثوانٍ</p>
