<div class="whatsapp-page touch-manipulation w-full max-w-6xl mx-auto min-w-0 overflow-x-clip px-4 pb-12 sm:px-6 lg:px-0 [-webkit-tap-highlight-color:transparent]" dir="rtl" data-tabs-container="whatsapp">

