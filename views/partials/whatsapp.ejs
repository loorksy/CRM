      </div>
      <div class="min-w-0">
        <label for="waVerbosity" class="block text-xs font-semibold uppercase tracking-wide text-slate-500">مستوى الإسهاب</label>
        <select id="waVerbosity" class="mt-2 w-full rounded-xl border border-slate-300 bg-slate-100 px-4 py-3 text-sm text-slate-900 focus:border-emerald-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500"></select>
