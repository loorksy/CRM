        <button type="button" id="waPersonaPreviewBtn" class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-xl border border-indigo-700 bg-indigo-600 px-5 text-sm font-semibold text-white transition hover:bg-indigo-700">
