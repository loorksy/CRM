        <button type="submit" id="waLinkSubmitBtn" class="inline-flex min-h-[44px] w-full items-center justify-center gap-2 rounded-xl border border-emerald-700 bg-emerald-600 px-5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
          <i class="fas fa-link" aria-hidden="true"></i>
