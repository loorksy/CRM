PORT=3020
# Default 3020 to avoid conflict with other apps on 3000
SESSION_SECRET=your-secret-key-change-this

# PostgreSQL (required)
DATABASE_URL=postgresql://lork:123456@localhost:5432/lorkerp
# DISABLE_BACKGROUND_SYNC=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Google Sheets API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SPREADSHEET_ID=
# ═══════════════ تكامل واتساب (Evolution API) ═══════════════
# Evolution مدمج داخل نفس عملية النظام على نفس المنفذ.
# 1 = تفعيل التضمين، أي قيمة أخرى أو الحذف = تعطيل التكامل كلياً
EVOLUTION_EMBEDDED=0
# المسار الذي يُركَّب عليه Evolution داخل النظام
EVOLUTION_MOUNT_PATH=/whatsapp-api
# مفتاح Evolution العام — يجب أن يطابق AUTHENTICATION_API_KEY في
# integrations/evolution-api/.env
EVOLUTION_API_KEY=
# اتركه فارغاً عند التضمين — يُشتق تلقائياً من المنفذ ومسار التركيب
EVOLUTION_API_URL=
# السر المشترك الذي يحمي نقطة /api/whatsapp/webhook (مطلوب)
WHATSAPP_WEBHOOK_SECRET=
# العنوان العام للنظام. اتركه فارغاً عند التضمين (يُستعمل العنوان المحلي)
PUBLIC_BASE_URL=

# ─── ضبط الوكيل والتحقق ───
WHATSAPP_OTP_TTL_MINUTES=10
WHATSAPP_OTP_MAX_ATTEMPTS=5
WHATSAPP_BLOCK_MINUTES=60
WHATSAPP_SESSION_TTL_MINUTES=720
WHATSAPP_RATE_LIMIT=20
WHATSAPP_RATE_WINDOW_SEC=60
WHATSAPP_AGENT_MAX_ROUNDS=4
WHATSAPP_MAX_REPLY_CHARS=3000
