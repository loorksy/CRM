PORT=3020
# Default 3020 to avoid conflict with other apps on 3000
SESSION_SECRET=your-secret-key-change-this

# PostgreSQL (required)
DATABASE_URL=postgresql://lork:123456@localhost:5432/lorkerp
# DISABLE_BACKGROUND_SYNC=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Google Sheets API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SPREADSHEET_ID=
# ═══════════════ تكامل واتساب (Evolution API) ═══════════════
# Evolution مدمج داخل نفس عملية النظام على نفس المنفذ.
# 1 = تفعيل التضمين، أي قيمة أخرى أو الحذف = تعطيل التكامل كلياً
EVOLUTION_EMBEDDED=0
# المسار الذي يُركَّب عليه Evolution داخل النظام
EVOLUTION_MOUNT_PATH=/whatsapp-api
# مفتاح Evolution العام — يجب أن يطابق AUTHENTICATION_API_KEY في
# integrations/evolution-api/.env
EVOLUTION_API_KEY=
# اتركه فارغاً عند التضمين — يُشتق تلقائياً من المنفذ ومسار التركيب
EVOLUTION_API_URL=
# السر المشترك الذي يحمي نقطة /api/whatsapp/webhook (مطلوب)
WHATSAPP_WEBHOOK_SECRET=
# العنوان العام للنظام. اتركه فارغاً عند التضمين (يُستعمل العنوان المحلي)
PUBLIC_BASE_URL=

# ─── ضبط الوكيل والتحقق ───
WHATSAPP_OTP_TTL_MINUTES=10
WHATSAPP_OTP_MAX_ATTEMPTS=5
WHATSAPP_BLOCK_MINUTES=60
WHATSAPP_SESSION_TTL_MINUTES=720
WHATSAPP_RATE_LIMIT=20
WHATSAPP_RATE_WINDOW_SEC=60
WHATSAPP_AGENT_MAX_ROUNDS=4
WHATSAPP_MAX_REPLY_CHARS=3000

# ─── طبقة بيانات الوكيل (RLS + عروض دلالية) ───
# بدون AGENT_DB_PASSWORD تُتخطّى الطبقة بالكامل ولا يتغير شيء في النظام.
# عند ضبطها يُنشأ دور قراءة مقيّد لا يملك صلاحية على أي جدول أساسي،
# ويستطيع الوكيل تأليف استعلاماته بحرية على عروض agent_v_* المفلترة.
AGENT_DB_USER=lorkerp_agent
AGENT_DB_PASSWORD=
# اختياري: رابط اتصال مستقل بدل اشتقاقه من DATABASE_URL
AGENT_DATABASE_URL=
AGENT_QUERY_MAX_ROWS=200
AGENT_QUERY_TIMEOUT_MS=8000
# 1 = سحب صلاحية set_config من PUBLIC ومنحها لدور التطبيق وحده.
# تشديد بنيوي يمنع أي استعلام من تغيير نطاقه بنفسه. تغيير على مستوى
# قاعدة البيانات، لذلك اتركه معطّلاً إن كانت أدوات أخرى تتصل بأدوار مختلفة.
AGENT_HARDEN_SET_CONFIG=0

# ─── تجربة المحادثة (محاكاة السلوك البشري) ───
# 0 = تعطيل الإيقاع البشري وإرسال الرد دفعة واحدة فوراً
WHATSAPP_HUMANIZE=1
WHATSAPP_TYPING_CPS=22
WHATSAPP_TYPING_MIN_MS=1200
WHATSAPP_TYPING_MAX_MS=9000
WHATSAPP_TYPING_SPEED=1
WHATSAPP_CHUNK_CHARS=600
WHATSAPP_MAX_CHUNKS=4

# ─── الرسائل الصوتية (تفريغ عبر Whisper) ───
# 0 = تعطيل. يستعمل مفتاح OpenAI من إعدادات النظام، أو OPENAI_API_KEY.
WHATSAPP_STT_ENABLED=1
WHATSAPP_STT_MODEL=whisper-1
WHATSAPP_STT_MAX_SECONDS=300
WHATSAPP_STT_MAX_BYTES=20000000
